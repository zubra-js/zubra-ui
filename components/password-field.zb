<!--
  A labelled password field on a native <input>, so it submits under its `name`, works with
  password managers (`autocomplete` is "current-password"; use "new-password" when one is being
  chosen) and validates as the browser's own (`required`, `minlength`). A button shows or hides
  what was typed, and is named for which it will do; the field warns when Caps Lock is on. The message
  shows after the field is left, or when the form is submitted. `value` is two-way.
  @fires valuechange - The text changed; `detail` is the new text.
-->
<script lang="ts">
  declare const autocomplete: "current-password" | "new-password" | "off";
  import { id } from '@zubra/runtime'

  const inputId = id()
  const helpId = id()
  const errorId = id()
  const capsId = id()
  let field = null
  let shown = false
  let caps = false
  // The browser's own message (or `error`, which wins), shown once the visitor has left the field.
  let message = ""
  const problem = error || message

  function check() {
    message = field ? field.validationMessage : ""
  }
  function input(event) {
    value = event.target.value
    if (message) check()
  }
  function leave() {
    caps = false
    check()
  }
  // (The show button keeps focus in the field on a press: the caret stays put, and leaving the
  // field is what checks it.)
  function key(event) {
    if (event.getModifierState) caps = event.getModifierState("CapsLock")
  }
</script>
<style>
  :host { display: block; }
  .password-stack { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.4rem; }
  label { font-weight: 600; font-size: 0.925rem; }
  .password-optional { font-weight: 400; color: color-mix(in oklab, var(--muted-foreground, #71717a) 75%, var(--foreground, #18181b)); }
  .password-help, .password-caps { margin: 0; font-size: 0.85rem; color: color-mix(in oklab, var(--muted-foreground, #71717a) 75%, var(--foreground, #18181b)); }
  .password-caps:empty { display: none; }
  .password-row { display: flex; border: 1px solid var(--input, #e4e4e7); border-radius: calc(var(--radius, 0.625rem) - 2px); background: var(--background, #fff); transition: border-color var(--duration-fast, 150ms), box-shadow var(--duration-fast, 150ms); }
  .password-row:focus-within { border-color: var(--ring, #a1a1aa); box-shadow: 0 0 0 3px color-mix(in oklab, var(--ring, #a1a1aa) 40%, transparent); }
  .password-row.password-invalid { border-color: var(--destructive, #dc2626); }
  input { flex: 1; min-width: 0; padding: 0.55rem 0.75rem; border: 0; border-radius: inherit; background: none; color: var(--foreground, #18181b); font: inherit; }
  input:focus-visible { outline: none; }
  input::placeholder { color: var(--muted-foreground, #71717a); }
  input:disabled { opacity: 0.55; cursor: not-allowed; }
  button { flex: none; margin: 0.2rem; padding: 0 0.6rem; border: 0; border-radius: calc(var(--radius, 0.625rem) - 4px); background: none; color: var(--foreground, #18181b); font: inherit; font-size: 0.825rem; font-weight: 600; cursor: pointer; }
  button:hover { background: var(--accent, #f4f4f5); }
  button:focus-visible { outline: 2px solid var(--ring, #a1a1aa); outline-offset: 1px; }
  button:disabled { opacity: 0.55; cursor: not-allowed; }
  .password-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .password-error { margin: 0; font-size: 0.85rem; color: var(--destructive, #dc2626); }
  .password-error:empty { display: none; }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition-duration: 0s !important; } }
</style>
<password-field value:model="" label="Password" description="" error="" name="" placeholder="" autocomplete="current-password" required={false} disabled={false} minlength={null} maxlength={null}>
  <div class="password-stack">
    <label for={inputId}>{label} <span zb-if={!required} class="password-optional">(optional)</span></label>
    <p zb-if={description} class="password-help" id={helpId}>{description}</p>
    <div class="password-row" class:password-invalid={Boolean(problem)}>
      <input ref={field} id={inputId} name={name || null} type={shown ? "text" : "password"} placeholder={placeholder || null} autocomplete={autocomplete} autocapitalize="off" spellcheck="false" required={required} disabled={disabled} minlength={minlength} maxlength={maxlength} aria-invalid={problem ? "true" : "false"} aria-describedby={[description ? helpId : "", capsId, problem ? errorId : ""].join(" ").trim()} value={value} oninput={input} onkeydown={key} onkeyup={key} onblur={leave} oninvalid={check}>
      <button type="button" aria-controls={inputId} disabled={disabled} onmousedown={(event) => event.preventDefault()} onclick={() => (shown = !shown)}>{shown ? "Hide" : "Show"}<span class="password-sr"> password</span></button>
    </div>
    <p class="password-caps" id={capsId} aria-live="polite">{caps ? "Caps Lock is on." : ""}</p>
    <p class="password-error" id={errorId} aria-live="polite">{problem}</p>
  </div>
</password-field>
